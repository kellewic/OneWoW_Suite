# ==============================================================
# EXTERNAL MODULES
# To add a module:
#   1. Create your folder: Modules\external\yourmodule\
#   2. module.lua FIRST: ns.ModuleRegistry:Define(ADDON_NAME, { id=..., ... })
#      (module.lua is the single home of the module id)
#   3. Locale + code files grab it at load:
#        local M, L = ns.ModuleRegistry:Current()   (capture, never call at runtime)
#      Locales register with Register(M._scope, locale, {...})
#   4. Add as many additional code files as your module needs
#   5. Reference another module via ns.ModuleRegistry:GetById("id"), never ns.X
#   6. Each module is fully self-contained in its folder (no data.lua needed)
#
# Load order: module.lua FIRST -> Locales -> your code files
#
# Minimum pattern:
#   Modules\external\yourmodule\module.lua
#   Modules\external\yourmodule\Locales\enUS.lua
#   Modules\external\yourmodule\yourmodule.lua
#
# Multi-file example (any number of code files is fine):
#   Modules\external\yourmodule\module.lua
#   Modules\external\yourmodule\Locales\enUS.lua
#   Modules\external\yourmodule\yourmodule.lua
#   Modules\external\yourmodule\logic.lua
#   Modules\external\yourmodule\ui.lua
# ==============================================================

